{
	"name": "backend-test-frameworks",
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "node --watch --loader ts-node/esm ./app.ts",
		"format": "npx @biomejs/biome format --write",
		"lint": "npx @biomejs/biome lint --write",
		"test-api:jest": "jest --selectProjects api",
		"test-api:vitest": "vitest --config ./apiTests/vitest/vitest.config.ts",
		"test-unit:jest": "jest --selectProjects unit",
		"test-unit:vitest": "vitest --config ./tests/vitest/vitest.config.ts"
	},
	"author": "",
	"license": "ISC",
	"description": "",
	"devDependencies": {
		"@babel/preset-env": "^7.28.3",
		"@babel/preset-typescript": "^7.27.1",
		"@biomejs/biome": "2.2.4",
		"@faker-js/faker": "^10.0.0",
		"@jest/globals": "^30.1.2",
		"@types/express": "^5.0.3",
		"@types/jest": "^30.0.0",
		"@types/supertest": "^6.0.3",
		"express": "^5.1.0",
		"jest": "^30.1.3",
		"nock": "^14.0.10",
		"supertest": "^7.1.4",
		"tsx": "^4.20.5",
		"vitest": "^3.2.4"
	}
}
